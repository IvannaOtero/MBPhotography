@{
	ViewData["Title"] = "Book a Session";
}

<section class="about-preview" aria-labelledby="booking-heading">
	<div class="about-preview__content">
		<p class="about-preview__eyebrow">Booking</p>
		<h1 id="booking-heading">Book a Session</h1>
		<p>You're in the right place to schedule your session with MBPhotography.</p>
		<p>Share your preferred date and session details, and we'll follow up to confirm availability.</p>
		<a class="about-preview__link" asp-controller="Packages" asp-action="Index">View packages</a>
	</div>
</section>