@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@section Styles {
    <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Home";
    var folder = System.IO.Path.Combine(Env.WebRootPath, "Pictures", "homepagecarousel");
    var allowed = new[] { ".jpg", ".jpeg", ".png", ".webp" };
    var slides = System.IO.Directory.Exists(folder)
        ? System.IO.Directory.GetFiles(folder)
            .Where(f => allowed.Contains(System.IO.Path.GetExtension(f).ToLowerInvariant()))
            .OrderBy(f => f, StringComparer.OrdinalIgnoreCase)
            .Take(4)
            .Select(System.IO.Path.GetFileName)
            .ToList()
        : new List<string?>();

    var packageSlides = new[]
    {
        new { FileName = "petslide.png", Hashtag = "#Pets", Alt = "Pet package collage" },
        new { FileName = "gradslide.png", Hashtag = "#GraduationDump", Alt = "Graduation package collage" },
        new { FileName = "funslide.png", Hashtag = "#PhotoDump", Alt = "Creative photo package collage" },
        new { FileName = "XVSlide.png", Hashtag = "#MyXV", Alt = "Quinceanera package collage" }
    }
    .Where(s => System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "Pictures", "SlidePackages", s.FileName)))
    .ToList();
}

@if (slides.Count > 0)
{
    <div id="heroCarousel" class="carousel slide carousel-fade hero-carousel" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-indicators">
            @for (var i = 0; i < slides.Count; i++)
            {
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : null)" aria-current="@(i == 0 ? "true" : null)"
                        aria-label="Slide @(i + 1)"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (var i = 0; i < slides.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : null)">
                    <img src="~/Pictures/homepagecarousel/@slides[i]" class="d-block w-100" alt="Featured photography @(i + 1)" />
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
}
else
{
    <div class="text-center">
        <h1 class="display-4">Welcome to MBPhotography</h1>
    </div>
}

<section class="about-feed" aria-labelledby="about-feed-heading">
    <div class="about-feed__intro">
        <h2 id="about-feed-heading">About Us!</h2>
        <p>We are MBPhotography, a faith based family doing photography, capturing the best memories to live forever with you!</p>
        <a class="about-feed__link" asp-controller="Home" asp-action="About">Read More &lt;3</a>
    </div>

    <div class="about-feed__gallery">
        <figure class="about-feed__photo about-feed__photo--landscape">
            <img src="~/Pictures/AbtUs/abtus1.jpeg" alt="MBPhotography outdoor session" />
        </figure>
        <figure class="about-feed__photo about-feed__photo--heart">
            <img src="~/Pictures/AbtUs/abtus2.jpeg" alt="MBPhotography candid moment" />
        </figure>
    </div>
</section>

@if (packageSlides.Count > 0)
{
    <section class="packages-feed" aria-labelledby="packages-feed-heading">
        <h2 id="packages-feed-heading">Our Packages!</h2>

        <div class="packages-slider" data-packages-slider data-autoplay="true" aria-live="polite">
            <button type="button" class="packages-slider__control packages-slider__control--prev" data-slide="prev" aria-label="Previous package slide">&#10094;</button>

            <div class="packages-slider__track">
                @for (var i = 0; i < packageSlides.Count; i++)
                {
                    var slide = packageSlides[i];
                    <article class="packages-slide @(i == 0 ? "is-active" : null)" data-slide-index="@i" aria-label="Package slide @(i + 1)">
                        <a class="packages-slide__link" asp-controller="Packages" asp-action="Index" aria-label="View packages">
                            <img src="~/Pictures/SlidePackages/@slide.FileName" asp-append-version="true" alt="@slide.Alt" />
                            <p class="packages-slide__tag">@slide.Hashtag</p>
                        </a>
                    </article>
                }
            </div>

            <button type="button" class="packages-slider__control packages-slider__control--next" data-slide="next" aria-label="Next package slide">&#10095;</button>
        </div>
    </section>
}

@section Scripts {
    <script>
        (() => {
            const slider = document.querySelector('[data-packages-slider]');
            if (!slider) return;

            const slides = Array.from(slider.querySelectorAll('.packages-slide'));
            if (!slides.length) return;

            const prevButton = slider.querySelector('[data-slide="prev"]');
            const nextButton = slider.querySelector('[data-slide="next"]');
            const autoplayEnabled = slider.dataset.autoplay === 'true';
            const autoplayDelay = 3500;
            let activeIndex = 0;
            let autoplayId;

            const getShortestOffset = (index) => {
                const total = slides.length;
                let offset = index - activeIndex;

                if (offset > total / 2) {
                    offset -= total;
                } else if (offset < -total / 2) {
                    offset += total;
                }

                return offset;
            };

            const render = () => {
                slides.forEach((slide, index) => {
                    const offset = getShortestOffset(index);

                    slide.classList.remove('is-active', 'is-side', 'is-left', 'is-right', 'is-away');

                    if (offset === 0) {
                        slide.classList.add('is-active');
                    } else if (Math.abs(offset) === 1) {
                        slide.classList.add('is-side', offset < 0 ? 'is-left' : 'is-right');
                    } else {
                        slide.classList.add('is-away');
                    }
                });
            };

            const goTo = (index) => {
                const total = slides.length;
                activeIndex = (index + total) % total;
                render();
            };

            const stopAutoplay = () => {
                if (!autoplayId) return;
                window.clearInterval(autoplayId);
                autoplayId = undefined;
            };

            const startAutoplay = () => {
                if (!autoplayEnabled) return;
                stopAutoplay();
                autoplayId = window.setInterval(() => goTo(activeIndex + 1), autoplayDelay);
            };

            prevButton?.addEventListener('click', () => {
                goTo(activeIndex - 1);
                startAutoplay();
            });

            nextButton?.addEventListener('click', () => {
                goTo(activeIndex + 1);
                startAutoplay();
            });

            slider.addEventListener('mouseenter', stopAutoplay);
            slider.addEventListener('mouseleave', startAutoplay);

            render();
            startAutoplay();
        })();
    </script>
}


