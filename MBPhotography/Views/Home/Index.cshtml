@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Home Page";
    var folder = System.IO.Path.Combine(Env.WebRootPath, "Pictures", "homepagecarousel");
    var allowed = new[] { ".jpg", ".jpeg", ".png", ".webp" };
    var slides = System.IO.Directory.Exists(folder)
        ? System.IO.Directory.GetFiles(folder)
            .Where(f => allowed.Contains(System.IO.Path.GetExtension(f).ToLowerInvariant()))
            .OrderBy(f => f, StringComparer.OrdinalIgnoreCase)
            .Take(4)
            .Select(System.IO.Path.GetFileName)
            .ToList()
        : new List<string?>();
}

@if (slides.Count > 0)
{
    <div id="heroCarousel" class="carousel slide carousel-fade hero-carousel" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-indicators">
            @for (var i = 0; i < slides.Count; i++)
            {
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : null)" aria-current="@(i == 0 ? "true" : null)"
                        aria-label="Slide @(i + 1)"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (var i = 0; i < slides.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : null)">
                    <img src="~/Pictures/homepagecarousel/@slides[i]" class="d-block w-100" alt="Featured photography @(i + 1)" />
                </div>
            }
        </div>
        <span class="hero-carousel__logo" aria-hidden="true">mbphoto</span>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
}
else
{
    <div class="text-center">
        <h1 class="display-4">Welcome</h1>
    </div>
}

<section class="about-preview" aria-labelledby="about-preview-heading">
    <div class="about-preview__inner">
        <div class="about-preview__image">
            <img src="~/Pictures/homepagecarousel/picture2.jpeg" alt="A portrait from an MBPhotography session" loading="lazy" />
        </div>
        <div class="about-preview__content">
            <p class="about-preview__eyebrow">A little about us</p>
            <h2 id="about-preview-heading">The people behind the photos</h2>
            <p>MBPhotography is a family-owned photography business in the Pacific Northwest. We love helping people feel at ease in front of the camera and capturing the moments they’ll treasure.</p>
            <a class="about-preview__link" asp-area="" asp-controller="Home" asp-action="About">Read More</a>
        </div>
    </div>
</section>
