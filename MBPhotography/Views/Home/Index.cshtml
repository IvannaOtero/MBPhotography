@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Home";
    var folder = System.IO.Path.Combine(Env.WebRootPath, "Pictures", "homepagecarousel");
    var allowed = new[] { ".jpg", ".jpeg", ".png", ".webp" };
    var slides = System.IO.Directory.Exists(folder)
        ? System.IO.Directory.GetFiles(folder)
            .Where(f => allowed.Contains(System.IO.Path.GetExtension(f).ToLowerInvariant()))
            .OrderBy(f => f, StringComparer.OrdinalIgnoreCase)
            .Take(4)
            .Select(System.IO.Path.GetFileName)
            .ToList()
        : new List<string?>();
}

@if (slides.Count > 0)
{
    <div id="heroCarousel" class="carousel slide carousel-fade hero-carousel" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-indicators">
            @for (var i = 0; i < slides.Count; i++)
            {
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : null)" aria-current="@(i == 0 ? "true" : null)"
                        aria-label="Slide @(i + 1)"></button>
            }
        </div>
        <div class="carousel-inner">
            @for (var i = 0; i < slides.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : null)">
                    <img src="~/Pictures/homepagecarousel/@slides[i]" class="d-block w-100" alt="Featured photography @(i + 1)" />
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
}
else
{
    <div class="text-center">
        <h1 class="display-4">Welcome to MBPhotography</h1>
    </div>
}

<section class="about-preview" aria-labelledby="about-preview-heading">
    <div class="about-preview__content">
        <p class="about-preview__eyebrow">Get to know us</p>
        <h2 id="about-preview-heading">Hi! We're MBPhotography :)</h2>
        <p>We're a warm, creative team that loves turning real moments into timeless photos. Our sessions are relaxed, fun, and centered around what feels most like you.</p>
        <p>From big celebrations to everyday magic, we're here to help you feel comfortable in front of the camera and leave with images you'll love for years.</p>
        <a class="about-preview__link" asp-controller="Home" asp-action="About">Meet the team</a>
    </div>
    <div class="about-preview__visual" aria-hidden="true">
        <figure class="about-preview__frame about-preview__frame--main">
            <img class="about-preview__portrait"
                 src="https://placehold.co/760x980/F2EFE7/8E0D1A?text=Abstract+Portrait"
                 alt="" />
        </figure>
        <figure class="about-preview__frame about-preview__frame--accent">
            <img src="https://placehold.co/360x460/E8E2D3/B7A27A?text=Mini+Portrait" alt="" />
        </figure>
        <p class="about-preview__caption">MBPhotography<br /><span>photography with heart</span></p>
    </div>
</section>
