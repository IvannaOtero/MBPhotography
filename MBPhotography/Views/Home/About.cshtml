@{
    ViewData["Title"] = "About Us";
}

<section class="about-page" aria-labelledby="about-page-heading">
    <div class="about-page__copy">
        <p class="about-page__eyebrow">A little about us</p>
        <h1 id="about-page-heading">Hi! :)</h1>
        <p>Welcome to MBPhotography! We’re a family-owned photography business based in the Pacific Northwest, and we believe the best photographs feel like you—full of connection, personality, and the little details you’ll want to remember.</p>
        <p>Whether you’re celebrating a milestone or gathering the people you love, we want your session to feel relaxed and personal. We’ll work with you to capture the moments that matter and create photographs you can come back to for years to come.</p>
        <p>Thank you for considering us to capture a part of your story. We can’t wait to meet you!</p>
        <a class="about-page__link" asp-controller="Home" asp-action="Portfolio">Explore our work</a>
    </div>
    <figure class="about-page__portrait">
        <img src="~/Pictures/homepagecarousel/picture!.jpeg" alt="A portrait from an MBPhotography session" />
        <figcaption>Family-owned · Pacific Northwest</figcaption>
    </figure>
</section>
