@{
    ViewData["Title"] = "About";
}

<section class="about-page" aria-labelledby="about-page-heading">
    <div class="about-page__copy">
        <p class="about-page__eyebrow">A little about us</p>
        <h1 id="about-page-heading">Hi! :)</h1>
        <p>Welcome to MBPhotography! We're a family-run photography team based in the Pacific Northwest, and we believe your photos should feel natural, joyful, and true to your story.</p>
        <p>Whether you're celebrating a milestone or simply soaking up everyday life, we'll guide you in a way that feels easy and fun while capturing the moments that matter most.</p>
        <p>Thanks for being here. We'd love to photograph this chapter with you.</p>
        <a class="about-page__link" asp-controller="Home" asp-action="Portfolio">Explore our work</a>
    </div>
    <figure class="about-page__portrait">
        <img src="https://placehold.co/720x900/F2EFE7/456DA9?text=Abstract+Studio+Shape" alt="Simple abstract placeholder for about page portrait" />
        <figcaption>Family-run · Pacific Northwest</figcaption>
    </figure>
</section>
