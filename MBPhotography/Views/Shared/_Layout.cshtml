<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MBPhotography</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MBPhotography.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isPortfolioPage = currentController == "Home" && currentAction == "Portfolio";
        var isPackagesPage = currentController == "Packages";
        var isSchedulePage = currentController == "Appointments";
        var isContactPage = currentController == "Home" && currentAction == "Contact";
        var isAboutPage = currentController == "Home" && currentAction == "About";
    }
    <header>
        <nav class="site-header navbar navbar-expand-lg navbar-light" aria-label="Main navigation">
            <div class="site-header__inner container-fluid">
                <button class="navbar-toggler site-header__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNavigation" aria-controls="primaryNavigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="primaryNavigation">
                    <ul class="navbar-nav site-header__links site-header__links--left">
                        <li class="nav-item">
                            <a class="nav-link @(isPortfolioPage ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Portfolio" aria-current="@(isPortfolioPage ? "page" : null)">Portfolio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isPackagesPage ? "active" : "")" asp-area="" asp-controller="Packages" asp-action="Index" aria-current="@(isPackagesPage ? "page" : null)">Packages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isSchedulePage ? "active" : "")" asp-area="" asp-controller="Appointments" asp-action="Create" aria-current="@(isSchedulePage ? "page" : null)">Schedule</a>
                        </li>
                    </ul>
                    <a class="navbar-brand site-header__brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="mbphoto home">mbphoto</a>
                    <ul class="navbar-nav site-header__links site-header__links--right">
                        <li class="nav-item">
                            <a class="nav-link @(isContactPage ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Contact" aria-current="@(isContactPage ? "page" : null)">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isAboutPage ? "active" : "")" asp-area="" asp-controller="Home" asp-action="About" aria-current="@(isAboutPage ? "page" : null)">About Us</a>
                        </li>
                        <li class="nav-item site-header__account">
                            <partial name="_LoginPartial" />
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="site-footer__main">
            <div class="site-footer__inner">
                <section class="site-footer__section" aria-labelledby="footer-social-heading">
                    <h2 id="footer-social-heading">Follow Along</h2>
                    <a class="site-footer__instagram" href="https://www.instagram.com/mbphoto/" target="_blank" rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle class="site-footer__icon-dot" cx="18" cy="6" r="1"></circle></svg>
                        <span>@@mbphoto</span>
                    </a>
                    <div class="site-footer__social-links" aria-label="More social media">
                        <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 21v-8h3l.5-4H14V7c0-1.2.4-2 2-2h1.7V1.4C17 1.2 15.8 1 14.5 1 11.4 1 9.5 2.8 9.5 6.2V9H6v4h3.5v8H14Z"></path></svg>
                        </a>
                        <a href="https://www.tiktok.com/" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.6 7.1a6.8 6.8 0 0 1-4.1-1.4v8.1a6.4 6.4 0 1 1-5.5-6.3v3.4a3 3 0 1 0 2.1 2.9V1h3.4a6.8 6.8 0 0 0 4.1 4.1v2Z"></path></svg>
                        </a>
                        <a href="https://www.pinterest.com/" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c0-.8 0-1.8.2-2.7l1.3-5.5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.8 0 1.2.6 1.2 1.4 0 .8-.5 2- .8 3.1-.2.9.4 1.6 1.3 1.6 1.6 0 2.8-1.7 2.8-4.2 0-2.2-1.6-3.7-3.9-3.7-2.7 0-4.3 2-4.3 4.1 0 .8.3 1.6.7 2 .2.2.2.3.2.6l-.3 1c-.1.3-.3.4-.6.2-1.2-.6-1.9-2.3-1.9-3.7 0-3 2.2-5.8 6.4-5.8 3.3 0 5.8 2.4 5.8 5.5 0 3.3-2.1 6-5 6-1 0-2-.6-2.4-1.2l-.7 2.7c-.2 1-.9 2-1.3 2.7A10 10 0 1 0 12 2Z"></path></svg>
                        </a>
                    </div>
                </section>

                <section class="site-footer__section" aria-labelledby="footer-areas-heading">
                    <h2 id="footer-areas-heading">Areas We Serve</h2>
                    <p>Serving the Pacific Northwest</p>
                    <details class="site-footer__areas">
                        <summary>View service areas</summary>
                        <ul>
                            <li>Washington</li>
                            <li>Oregon</li>
                        </ul>
                    </details>
                </section>

                <section class="site-footer__section" aria-labelledby="footer-contact-heading">
                    <h2 id="footer-contact-heading">Get in Touch</h2>
                    <p>Have a question or want to book a session?</p>
                    <a asp-area="" asp-controller="Home" asp-action="Contact">Contact us</a>
                    <p class="site-footer__contact-note">We'd love to hear from you about your session.</p>
                </section>

                <nav class="site-footer__section" aria-labelledby="footer-links-heading">
                    <h2 id="footer-links-heading">Explore</h2>
                    <ul class="site-footer__links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Portfolio">Portfolio</a></li>
                        <li><a asp-area="" asp-controller="Packages" asp-action="Index">Packages</a></li>
                        <li><a asp-area="" asp-controller="Appointments" asp-action="Create">Schedule</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                </nav>
            </div>
        </div>
        <div class="site-footer__divider" aria-hidden="true"><span>✿</span><span class="site-footer__divider-line"></span><span>Made with love in the PNW</span><span class="site-footer__divider-line"></span><span>✿</span></div>
        <div class="site-footer__bottom">
            <span>&copy; @DateTime.Now.Year MBPhotography. All rights reserved.</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
