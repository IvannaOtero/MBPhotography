<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MBPhotography</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MBPhotography.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isPortfolioPage = currentController == "Home" && currentAction == "Index";
        var isPackagesPage = currentController == "Packages";
        var isSchedulePage = currentController == "Appointments";
        var isContactPage = currentController == "Home" && currentAction == "Contact";
        var isAboutPage = currentController == "Home" && currentAction == "About";
    }
    <header>
        <nav class="site-header navbar navbar-expand-lg navbar-light" aria-label="Main navigation">
            <div class="site-header__inner container-fluid">
                <button class="navbar-toggler site-header__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNavigation" aria-controls="primaryNavigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="primaryNavigation">
                    <ul class="navbar-nav site-header__links site-header__links--left">
                        <li class="nav-item">
                            <a class="nav-link @(isPortfolioPage ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="portfolio" aria-current="@(isPortfolioPage ? "page" : null)">Portfolio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isPackagesPage ? "active" : "")" asp-area="" asp-controller="Packages" asp-action="Index" aria-current="@(isPackagesPage ? "page" : null)">Packages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isSchedulePage ? "active" : "")" asp-area="" asp-controller="Appointments" asp-action="Create" aria-current="@(isSchedulePage ? "page" : null)">Schedule</a>
                        </li>
                    </ul>
                    <a class="navbar-brand site-header__brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="mbphoto home">mbphoto</a>
                    <ul class="navbar-nav site-header__links site-header__links--right">
                        <li class="nav-item">
                            <a class="nav-link @(isContactPage ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="contact" aria-current="@(isContactPage ? "page" : null)">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isAboutPage ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="about" aria-current="@(isAboutPage ? "page" : null)">About Us</a>
                        </li>
                        <li class="nav-item site-header__account">
                            <partial name="_LoginPartial" />
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - MBPhotography - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
