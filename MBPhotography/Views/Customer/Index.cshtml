@model IEnumerable<MBPhotography.Models.Customer>

@{
	ViewData["Title"] = "Customers";
}

<h1>Customers</h1>

<table class="table table-striped table-bordered">
	<thead>
		<tr>
			<th>Id</th>
			<th>First Name</th>
			<th>Last Name</th>
			<th>Email</th>
			<th>Phone</th>
			<th>City</th>
			<th>State</th>
			<th>Zip</th>
		</tr>
	</thead>
	<tbody>
	@if (Model != null)
	{
		foreach (var customer in Model)
		{
			<tr>
				<td>@customer.Id</td>
				<td>@customer.FirstName</td>
				<td>@customer.LastName</td>
				<td>@customer.Email</td>
				<td>@customer.PhoneNumber</td>
				<td>@customer.City</td>
				<td>@customer.State</td>
				<td>@customer.ZipCode</td>
			</tr>
		}
	}
	</tbody>
</table>
